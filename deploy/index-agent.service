[Unit]
Description=Index 01 ring agent (webhook -> vault notes, Todoist, bb threads)
Wants=network-online.target tailscaled.service bb-app.service obsidian-sync.service
After=network-online.target tailscaled.service bb-app.service obsidian-sync.service
RequiresMountsFor=/path/to/index-agent /path/to/vault
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=dev
WorkingDirectory=/path/to/index-agent
Environment=HOME=/home/you
Environment=PATH=/home/you/.local/bin:/home/you/.local/npm/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOST=127.0.0.1
Environment=PORT=8790
Environment=BB_PERMISSION_MODE=full
ExecStart=/home/you/.local/npm/bin/bun run server.ts
# Public HTTPS for the ring app. Funnel config also persists in tailscaled; re-applying is harmless.
ExecStartPost=-/usr/bin/tailscale funnel --bg --https=10000 http://127.0.0.1:8790
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=index-agent

[Install]
WantedBy=multi-user.target
