# Copy to .env and fill in. Bun loads .env automatically. Never commit .env.

# --- Required ---
# Where phones reach this server over HTTPS (e.g. Tailscale Funnel), no trailing slash.
PUBLIC_URL=https://your-host.your-tailnet.ts.net:10000
# Your Obsidian vault (or any Markdown folder) and the folder new notes go to.
VAULT_DIR=/path/to/vault
INBOX_DIR=inbox
# IANA time zone used for note names, dates and "tomorrow".
LOCAL_TZ=America/Chicago

# --- Pebble Index 01 ring (webhook at /index) ---
INDEX_WEBHOOK_SECRET=
# Optional actions:
TODOIST_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# bb threads (start_thread action): your bb project and environment ids.
BB_PROJECT=
BB_ENVIRONMENT=
BB_PERMISSION_MODE=auto

# --- Omi (webhook at /omi/<secret>, live transcription at /stt/<secret>) ---
# At least 24 random characters, e.g. `openssl rand -hex 24`. It is the URL's only protection.
OMI_WEBHOOK_SECRET=
# How the distiller refers to you ("Me" in transcripts).
OWNER_NAME=Your Name
# Margins workspace id used for `margins recall` (see `margins status`).
MARGINS_WORKSPACE=obsidian
# OMI_ASR=0 turns the local speech service off (Omi's own transcripts are used).
# OMI_AUDIO_RETENTION_DAYS=7

# --- Notifications (optional) ---
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
